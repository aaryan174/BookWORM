# Node Environment & Server Config
NODE_ENV=development
PORT=5000

# Database URI (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bookworm?retryWrites=true&w=majority

# JWT Secrets (Minimum 32 characters for security)
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL for CORS & Cookie Domain
FRONTEND_URL=http://localhost:5173

# Razorpay Configuration (Test key/secrets for development)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Financial Rules
PLATFORM_COMMISSION_RATE=0.10
DEFAULT_TAX_RATE=0.05
DEFAULT_SHIPPING_FEE=50
FREE_SHIPPING_THRESHOLD=999

# ImageKit Configuration for Book Covers & Media Storage
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_bookworm_endpoint
