# Backend API URL (Optional)
# - Leave blank if deploying frontend & backend together on the same domain or in development (Vite proxies /api to port 5000)
# - Set to your deployed backend URL if hosting frontend separately on Render Static Site (e.g., https://bookworm-api.onrender.com)
VITE_API_URL=
